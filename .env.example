# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── API Keys ──────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Database ──────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/tracker

# ── Google / OAuth ────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Application ───────────────────────────────────────────
# APP_ENV=development
# LOG_LEVEL=INFO
